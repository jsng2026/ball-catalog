  "tips": [
    {
      "id": "caps",
      "title": "Why caps change the answer",
      "body": "Bonus rates come with monthly caps (often $1,000–$1,500). Once a cap is filled, spend earns the base rate — usually 0.4 mpd. Ball tracks your caps and reroutes you to the next-best card automatically."
    },
    {
      "id": "overseas",
      "title": "Overseas isn't what it looks like",
      "body": "Overseas spend usually pays a foreign transaction fee of ~3.25%. A 4 mpd card that only earns locally can lose to a 2.4 mpd overseas card once the fee and FCY rates are counted. Ball ranks by net value, not raw miles."
    },
    {
      "id": "blocks",
      "title": "The $5-block trap",
      "body": "Some cards award points per $5 block — a $4.90 kopi earns nothing. Small payments belong on per-dollar cards; Ball routes them there."
    }
  ]
